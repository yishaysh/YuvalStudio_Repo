# ============================================
# Public Browser Variables (SAFE FOR CLIENT BUNDLE)
# ============================================
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_APP_VERSION=2026.11.14-qa1

# ============================================
# Server-Only Variables (NEVER prefix with VITE_)
# Configure these in Vercel Project Settings -> Environment Variables
# ============================================
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SESSION_SECRET=replace_with_at_least_32_random_bytes_hex
ADMIN_EMAILS=studio_owner@example.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Style Matcher (server-side proxy only)
GEMINI_API_KEY=your_server_gemini_api_key

# Cloudinary Signed Uploads (server-side only)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Notification Credentials (server-side fallback when omitted in studio_settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
NOTIFICATION_EMAIL=
